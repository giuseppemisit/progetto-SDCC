# Copiare in .env e valorizzare (cp .env.example .env)
# Non versionato, contiene segreti. Le variabili senza default sono obbligatorie,
# docker-compose usa ${VAR:?...} quindi se manca qualcosa l'avvio si blocca con un errore chiaro

# PostgreSQL
POSTGRES_USER=sdcc_user
POSTGRES_PASSWORD=           # openssl rand -base64 24
POSTGRES_DB=documenti_comunali

# Garage (Object Storage S3-compatibile)
GARAGE_ACCESS_KEY=GKsdccgaragekey2026
GARAGE_SECRET_KEY=           # openssl rand -hex 32

# Backend
DATABASE_URL=postgresql://sdcc_user:<POSTGRES_PASSWORD>@db:5432/documenti_comunali
S3_ENDPOINT=http://garage:3900
S3_ACCESS_KEY=GKsdccgaragekey2026
S3_SECRET_KEY=<GARAGE_SECRET_KEY>
S3_BUCKET_NAME=document-images

# Endpoint per i Presigned URL letti dal browser, serve per la firma SigV4 in Docker locale
# In locale: http://localhost:3900, in produzione lasciare vuoto e usa S3_ENDPOINT
S3_PUBLIC_ENDPOINT=http://localhost:3900

# AI Model
MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2